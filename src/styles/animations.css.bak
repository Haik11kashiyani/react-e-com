/* ===== Global Animation Styles ===== */

/* Smooth scroll */
html {
  scroll-behavior: smooth;
}

/* Page transition wrapper */
.page-transition {
  animation: pageIn 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

@keyframes pageIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Scroll reveal base classes */
.scroll-reveal {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.scroll-reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

/* Reveal from left */
.scroll-reveal-left {
  opacity: 0;
  transform: translateX(-40px);
  transition: opacity 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.scroll-reveal-left.visible {
  opacity: 1;
  transform: translateX(0);
}

/* Scale reveal */
.scroll-reveal-scale {
  opacity: 0;
  transform: scale(0.9);
  transition: opacity 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.scroll-reveal-scale.visible {
  opacity: 1;
  transform: scale(1);
}

/* Stagger delay utilities */
.stagger-1 { transition-delay: 0.05s; }
.stagger-2 { transition-delay: 0.1s; }
.stagger-3 { transition-delay: 0.15s; }
.stagger-4 { transition-delay: 0.2s; }
.stagger-5 { transition-delay: 0.25s; }
.stagger-6 { transition-delay: 0.3s; }
.stagger-7 { transition-delay: 0.35s; }
.stagger-8 { transition-delay: 0.4s; }

/* Magnetic button effect */
.magnetic-btn {
  transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  will-change: transform;
}

/* Smooth image hover */
.img-hover-zoom {
  overflow: hidden;
}

.img-hover-zoom img {
  transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  will-change: transform;
}

.img-hover-zoom:hover img {
  transform: scale(1.06);
}

/* Text gradient */
.text-gradient {
  background: linear-gradient(135deg, #1a1a1a 0%, #666 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.text-gradient-green {
  background: linear-gradient(135deg, #a1ff62 0%, #22a06b 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* ===== Design Tokens ===== */
:root {
  --vw-dark: #1a1a1a;
  --vw-accent: #a1ff62;
  --vw-bg: #F4F4F4;
  --vw-white: #fff;
  --vw-text: #1a1a1a;
  --vw-text-muted: #888;
  --vw-border: #e5e5e5;
  --vw-font-heading: 'Amarna', sans-serif;
  --vw-font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  --vw-radius: 20px;
  --vw-radius-sm: 12px;
  --vw-ease: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --vw-pad-x: 5vw;
  --vw-max-w: 1200px;
}

/* ===== Universal Page Hero ===== */
.page-hero {
  padding: 160px var(--vw-pad-x) 80px;
  text-align: center;
  background: var(--vw-dark);
  color: var(--vw-white);
}
.page-hero__inner {
  max-width: 700px;
  margin: 0 auto;
}
.page-hero__title {
  font-family: var(--vw-font-heading);
  font-size: clamp(2.4rem, 6vw, 4.2rem);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.02em;
  margin: 16px 0 20px;
}
.page-hero__sub {
  font-size: 1.05rem;
  opacity: 0.65;
  line-height: 1.6;
  max-width: 520px;
  margin: 0 auto;
}

/* ===== Universal Section Title ===== */
.section-title {
  font-family: var(--vw-font-heading);
  font-size: clamp(1.6rem, 4vw, 2.8rem);
  font-weight: 800;
  color: var(--vw-text);
  letter-spacing: -0.02em;
  line-height: 1.1;
  margin: 0 0 16px;
}
.section-desc {
  font-size: 1rem;
  color: var(--vw-text-muted);
  line-height: 1.7;
  max-width: 520px;
}

/* Section spacing */
.section {
  padding: 100px var(--vw-pad-x);
  max-width: var(--vw-max-w);
  margin: 0 auto;
}

.section-sm {
  padding: 60px var(--vw-pad-x);
  max-width: var(--vw-max-w);
  margin: 0 auto;
}

/* Eyebrow / label  */
.eyebrow-tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--vw-dark);
  color: var(--vw-accent);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  padding: 6px 16px;
  border-radius: 24px;
  margin-bottom: 20px;
}

/* Inside dark hero, eyebrow needs a different bg */
.page-hero .eyebrow-tag {
  background: rgba(255, 255, 255, 0.08);
}

.eyebrow-tag::before {
  content: '';
  width: 6px;
  height: 6px;
  background: var(--vw-accent);
  border-radius: 50%;
}

/* Section headings (legacy compat) */
.section-heading {
  font-family: var(--vw-font-heading);
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 800;
  color: var(--vw-text);
  letter-spacing: -0.02em;
  line-height: 1.08;
  margin: 0 0 16px;
}

.section-subtitle {
  font-size: 1rem;
  color: var(--vw-text-muted);
  max-width: 520px;
  line-height: 1.6;
  margin: 0;
}

/* Horizontal rule animated */
.animated-hr {
  height: 1px;
  background: #e0e0e0;
  border: none;
  margin: 40px 0;
  transform-origin: left;
  animation: hrReveal 1s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

@keyframes hrReveal {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}

/* Card base */
.card {
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              box-shadow 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.card:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
}

/* Pill button base */
.pill-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 32px;
  border-radius: 50px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  border: none;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative;
  overflow: hidden;
}

.pill-btn-primary {
  background: #1a1a1a;
  color: #fff;
}

.pill-btn-primary:hover {
  background: #333;
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
}

.pill-btn-green {
  background: #a1ff62;
  color: #1a1a1a;
}

.pill-btn-green:hover {
  box-shadow: 0 8px 24px rgba(161, 255, 98, 0.3);
  transform: translateY(-2px);
}

.pill-btn-outline {
  background: transparent;
  color: #1a1a1a;
  border: 1.5px solid #1a1a1a;
}

.pill-btn-outline:hover {
  background: #1a1a1a;
  color: #fff;
}

/* Marquee base */
.marquee-base {
  display: flex;
  overflow: hidden;
  user-select: none;
  -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
}

.marquee-track-base {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 60px;
  animation: marqueeScroll 30s linear infinite;
}

@keyframes marqueeScroll {
  from { transform: translateX(0); }
  to { transform: translateX(-100%); }
}

/* Ghost loading state */
.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 8px;
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

/* Grid utility */
.grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }

@media (max-width: 900px) {
  .grid-3, .grid-4 { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 600px) {
  .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
  .section { padding: 60px var(--vw-pad-x); }
  .section-sm { padding: 40px var(--vw-pad-x); }
  .page-hero { padding: 140px var(--vw-pad-x) 60px; }
}

/* Cursor follower (optional enhancement) */
.custom-cursor {
  width: 20px;
  height: 20px;
  border: 2px solid #1a1a1a;
  border-radius: 50%;
  position: fixed;
  pointer-events: none;
  z-index: 9999;
  transition: transform 0.15s ease, width 0.3s ease, height 0.3s ease;
  mix-blend-mode: difference;
}

/* Toast notification */
.toast {
  position: fixed;
  bottom: 30px;
  right: 30px;
  background: #1a1a1a;
  color: #fff;
  padding: 16px 28px;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 600;
  z-index: 10000;
  display: flex;
  align-items: center;
  gap: 10px;
  animation: toastIn 0.4s ease, toastOut 0.4s ease 2.5s forwards;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
}

.toast-green {
  background: #22a06b;
}

@keyframes toastIn {
  from { transform: translateY(20px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

@keyframes toastOut {
  from { transform: translateY(0); opacity: 1; }
  to { transform: translateY(20px); opacity: 0; }
}
