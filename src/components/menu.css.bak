/* ==================== NAVBAR (MORPHING) ==================== */

/* Placeholder to keep layout stable */
.navbar-placeholder {
    height: 60px;
    margin: 10px auto 5px auto;
    width: 90%;
    max-width: 600px;
}

.navbar {
    display: flex;
    flex-direction: column; /* Changed to column to stack header and content */
    background: #1a1a1a;
    z-index: 100;
    overflow: hidden;

    /* Initial State (Pill) */
    position: fixed; /* Fixed to keep it visible on scroll if needed, or absolute */
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 600px;
    height: 60px;
    border-radius: 5px; /* Matched to marquee */
    padding: 0; 

    /* Transition Config: Close Animation (Reverse) */
    /* Height shrinks first, then Width */
    transition: 
        height 0.4s cubic-bezier(0.77, 0, 0.175, 1) 0.4s, /* Delay height shrinkage */
        width 0.4s cubic-bezier(0.77, 0, 0.175, 1) 0s,
        max-width 0.4s cubic-bezier(0.77, 0, 0.175, 1) 0s,
        top 0.4s cubic-bezier(0.77, 0, 0.175, 1) 0.4s,
        border-radius 0.4s cubic-bezier(0.77, 0, 0.175, 1) 0s,
        background 0.3s ease;
}

.navbar.open {
    /* Open State (Fullscreen) */
    width: 100vw;
    max-width: 100vw; 
    /* Keep centered position */
    left: 50%; 
    transform: translateX(-50%);
    
    top: 0;
    height: 100vh;
    border-radius: 0;

    /* Transition Config: Open Animation */
    /* Width expands first, then Height */
    transition: 
        width 0.4s cubic-bezier(0.77, 0, 0.175, 1) 0s,
        max-width 0.4s cubic-bezier(0.77, 0, 0.175, 1) 0s,
        border-radius 0.4s cubic-bezier(0.77, 0, 0.175, 1) 0s,
        
        height 0.6s cubic-bezier(0.77, 0, 0.175, 1) 0.4s, /* Delay Height */
        top 0.6s cubic-bezier(0.77, 0, 0.175, 1) 0.4s;    /* Delay Top */
}

/* ==================== BUTTONS & HEADER TWEAKS (Final Fix) ==================== */

/* Header Section (Logo, Buttons) */
.navbar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 60px; /* Fixed height for header part */
    padding: 0 16px; /* Balanced padding */
    flex-shrink: 0;
    
    /* Ensure header content stretches decently during transition */
    margin: 0 auto;
    max-width: 100%; 
    transition: padding 0.3s ease;
}

.navbar.open .navbar-header {
    padding: 0 40px; 
}

/* Common Nav Elements */
.nav-left {
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
    /* Removed min-width to prevent rigid spacing */
}

/* Fixed Logo Centering */
.nav-center {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
}

.nav-right {
    display: flex;
    align-items: center;
    gap: 10px;
    justify-content: flex-end;
    /* Removed rigid min-width */
}

/* Nav Icon Links */
.nav-icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: #fff;
    transition: background 0.25s, color 0.25s;
    position: relative;
    text-decoration: none;
}
.nav-icon-link:hover {
    background: rgba(255, 255, 255, 0.1);
}
.cart-badge {
    position: absolute;
    top: -2px;
    right: -4px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #a1ff62;
    color: #1a1a1a;
    font-size: 10px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    pointer-events: none;
}

/* Button Styles - Optimized for Space */
.btn {
    padding: 8px 20px; /* Restored comfortable padding */
    border-radius: 25px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    border: none;
    position: relative;
    overflow: visible; /* Ensure nothing is hidden */
    text-align: center;
    white-space: nowrap;
    line-height: 1.2; /* Better vertical centering */
    display: flex; /* Use flex to center span content */
    justify-content: center;
    align-items: center;
    min-width: 60px; /* Minimum clickable width */
}

/* MARQUEE BANNER - MATCHING NAVBAR */
.marquee-banner {
    width: 90%; /* Match Navbar Width */
    max-width: 600px; /* Match Navbar Max-Width */
    border-radius: 9px; /* Match Navbar Border Radius (Standard Pill) */
    background: #a1ff62;
    overflow: hidden;
    padding: 5px 0;
    margin: 20px auto 10px auto; /* Centered with top margin */
    position: relative;
    z-index: 10;
    transition: transform 0.5s ease, margin-top 0.5s ease, opacity 0.5s ease;
}

/* Update Navbar to Match Marquee exactly if needed, assuming Navbar is already 90%/600px 
   Ensuring Border Radius is consistent */
.navbar {
    /* ... previous styles ... */
    border-radius: 9px; 
}

.btn span {
    display: block;
    transition: none;
    transform-origin: center 120px; 
    -webkit-font-smoothing: antialiased;
    backface-visibility: hidden;
    transform: translateZ(0); 
}

.btn span:first-child {
    position: relative;
    transform: rotate(0deg);
}

.btn span:last-child {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    transform: rotate(-25deg); 
    opacity: 0;
}

.btn:hover span {
    transition: transform 0.8s cubic-bezier(0.19, 1, 0.22, 1), opacity 0.4s ease;
}

.btn:hover span:first-child {
    transform: rotate(25deg); 
    opacity: 0;
}

.btn:hover span:last-child {
    transform: rotate(0deg);
    opacity: 1;
}
.btn-login {
    background: #2a2a2a;
    color: white;
}

.btn-login:hover {
    background: #3a3a3a;
}

.btn-join {
    background:#a1ff62;
    color: #1a1a1a;
}

.btn-join:hover {
    background: #a1ff62;
}


/* ==================== MENU CONTENT ==================== */

.menu-content {
    flex: 1;
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center; /* Center vertically */
    padding-bottom: 40px;
    
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
    
    /* Close transition */
    transition: opacity 0.2s ease 0s, transform 0.2s ease 0s;
}

.navbar.open .menu-content {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    
    /* Open transition (Delayed) */
    transition: opacity 0.6s ease 0.9s, transform 0.6s ease 0.9s;
}

/* Columns */
.menu-column {
    flex: 1;
    padding: 20px;
    color: #fff;
}

.menu-label {
    display: block;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 24px;
    opacity: 0.5;
}

.menu-links {
    list-style: none;
    padding: 0;
    margin: 0;
}

.menu-links li {
    margin-bottom: 16px;
}

.menu-links a {
    color: #fff;
    text-decoration: none;
    font-size: 32px;
    font-weight: 500;
    display: inline-block;
    transition: transform 0.3s;
}

.menu-links a:hover {
    transform: translateX(10px);
}

/* Badges */
.badge-new {
    background: #7c3aed;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    vertical-align: middle;
    margin-left: 8px;
}

.badge-wip {
    background: #444;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    vertical-align: middle;
    margin-left: 8px;
}

.count {
    font-size: 12px;
    opacity: 0.5;
    vertical-align: super;
    margin-left: 4px;
}

/* Featured Card */
.featured-column {
    display: flex;
    justify-content: flex-end;
}

.featured-card {
    background: #222;
    padding: 30px;
    border-radius: 16px;
    width: 100%;
    max-width: 400px;
    text-align: center;
}

.available-badge {
    background: #000;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 10px;
    text-transform: uppercase;
    margin-bottom: 20px;
    display: inline-block;
}

.available-badge span {
    color: #7c3aed;
    font-weight: 700;
}

.featured-card h3 {
    font-size: 28px;
    margin: 0 0 20px;
    font-weight: 400;
}

.card-image-placeholder {
    width: 100%;
    height: 150px;
    background: #333;
    border-radius: 8px;
    margin-bottom: 20px;
}

.btn-more-info {
    background: #fff;
    color: #000;
    border: none;
    padding: 10px 20px;
    border-radius: 4px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
}

.btn-more-info:hover {
    background: #eee;
}

.menu-socials {
    display: flex;
    gap: 12px;
    margin-top: 40px;
}

.menu-socials a {
    width: 36px;
    height: 36px;
    background: #333;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    color: #fff;
    text-decoration: none;
    font-size: 14px;
    transition: background 0.3s;
}

.menu-socials a:hover {
    background: #555;
}

/* Marquee Banner */
/* Marquee Banner */
.marquee-banner {
    width: 90%; /* Match Navbar Width */
    max-width: 600px; /* Match Navbar Max-Width */
    border-radius: 9px; /* Match Navbar Border Radius */
    background: #a1ff62;
    overflow: hidden;
    padding: 5px 0;
    margin: 9px auto;
    position: relative;
    z-index: 10;
    transition: transform 0.5s ease, margin-top 0.5s ease, opacity 0.5s ease;
}

.marquee-banner.scrolled {
    transform: translateY(-120%); 
    margin-top: -30px; 
    opacity: 0;
    z-index: -1; 
}

.marquee-track {
    display: flex;
    gap: 20px;
    animation: scroll 90s linear infinite;
    white-space: nowrap;
    width: max-content;
    flex-shrink: 0;
}

.marquee-track span {
    font-size: 9px;
    font-weight: 600;
    color: #1a1a1a;
    text-transform: uppercase;
    letter-spacing: 1px;
    flex-shrink: 0;
}

@keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}

@media (max-width: 768px) {
    .menu-content {
        flex-direction: column;
        overflow-y: auto;
        height: auto;
        padding-top: 20px;
        align-items: flex-start;
    }

    .menu-links a {
        font-size: 24px;
    }
    
    .featured-column {
        display: none; 
    }
}